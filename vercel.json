{
    "headers": [
      {
        "source": "/(.*)\\.(js|css|woff2|ttf|png|jpg|jpeg|svg)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/(.*)\\.html$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800, stale-while-revalidate=86400"
          }
        ]
      }
    ]
  }